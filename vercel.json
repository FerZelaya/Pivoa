{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "pnpm install",
	"buildCommand": "pnpm --filter @pivoa/shared build && pnpm --filter @pivoa/web build",
	"outputDirectory": "apps/web/dist",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://pivoa-api-production.up.railway.app/api/:path*"
		},
		{
			"source": "/((?!api/).*)",
			"destination": "/index.html"
		}
	]
}