# Pivoa Environment Configuration
# Copy this file to .env in the root or each app directory
# For local Supabase, run `pnpm db:start` and use values from `pnpm db:status`

# ============================================
# API Server (apps/api/.env)
# ============================================

# Server configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Supabase configuration (get from `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-status

# ============================================
# Web App (apps/web/.env)
# ============================================

# Supabase configuration for client-side auth
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status

# ============================================
# AI Provider (for receipt scanning)
# ============================================
# Options: mock (default, for testing), gemini, openai, anthropic
AI_PROVIDER=mock

# Gemini (recommended - has free tier)
# Get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (alternative)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Anthropic (alternative)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
