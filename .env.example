# Pivoa Environment Configuration
# Copy this file to .env in the root or each app directory
# For local Supabase, run `pnpm db:start` and use values from `pnpm db:status`

# ============================================
# API Server (apps/api/.env)
# ============================================

# Server configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Supabase configuration (get from `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-status

# ============================================
# Web App (apps/web/.env)
# ============================================

# Supabase configuration for client-side auth
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status

# ============================================
# Future: AI Provider (Phase 4)
# ============================================
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
