    "faq": {
      "eyebrow": "Questions",
      "title": "Frequently asked",
      "items": {
        "free": {
          "q": "Is Pivoa free?",
          "a": "Yes. Free includes onboarding, one currency, 50 expenses per cycle and one savings goal — no card required."
        },
        "plans": {
          "q": "What do Plus and Pro unlock?",
          "a": "Plus adds unlimited expenses and goals, multi-currency, CSV export and 40 receipt scans per cycle. Pro raises scans to 200 and prioritizes your support tickets."
        },
        "changeBudget": {
          "q": "Can I change my monthly budget later?",
          "a": "Anytime. Your income cap, category caps and goals are all editable in Settings."
        },
        "receipts": {
          "q": "How does receipt scanning work?",
          "a": "Upload a photo of a receipt and Pivoa uses AI to extract the amount, merchant, date and a suggested category. Scans are included with Plus and Pro."
        },
        "privacy": {
          "q": "Is my data private?",
          "a": "Your data is protected with row-level security — only you can read your expenses, budgets and goals."
        }
      }
