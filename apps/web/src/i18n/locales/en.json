    "hero": {
      "badge": "Modern Financial Studio",
      "titleBefore": "Budget your month.",
      "titleAccent": "Hit every goal.",
      "subtitle": "Pivoa turns your monthly income into a clear plan — category caps, savings goals and real-time pacing, with AI receipt scanning built in.",
