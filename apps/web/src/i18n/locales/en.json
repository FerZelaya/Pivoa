    "features": {
      "eyebrow": "Everything in one workspace",
      "title": "Built for monthly discipline",
      "items": {
        "incomeCap": {
          "title": "Monthly income cap",
          "text": "Set what you earn — say $3,000 — and Pivoa paces every day against it with a safe daily run rate."
        },
        "categoryBudgets": {
          "title": "Category budgets",
          "text": "Give Food, Housing or Shopping their own cap. Cards turn amber at 80% and red once you go over."
        },
        "savingsGoals": {
          "title": "Savings goals",
          "text": "Track an emergency fund or a trip with target dates, the monthly pace you need, and one-tap boosts."
        },
        "receiptScanning": {
          "title": "AI receipt scanning",
          "text": "Snap a receipt and the amount, merchant, date and category are filled in for you automatically."
        },
        "cashFlow": {
          "title": "Cash-flow velocity",
          "text": "See cumulative spending against your income baseline, peak outflow days and month-end projections."
        },
        "ledger": {
          "title": "Searchable ledger",
          "text": "Filter by date or category, search merchants and notes, bulk-select, and export to CSV in a click."
        },
        "multiCurrency": {
          "title": "Multi-currency",
          "text": "Log expenses in any currency and keep a single base currency for budgets, goals and totals."
        },
        "cycles": {
          "title": "Custom budget cycles",
          "text": "Reset on any day of the month — payday-aligned windows, not just calendar months."
        },
        "support": {
          "title": "In-app support",
          "text": "Open tickets from the help bubble. Pro gets high-priority responses when you need them most."
        },
        "languages": {
          "title": "English & Spanish",
          "text": "Use Pivoa in English or Español. Language follows your browser by default and stays in sync across devices."
        },
        "alerts": {
          "title": "Budget alerts",
          "text": "Get notified when a category hits 80% or when your monthly cap is exceeded."
        },
        "security": {
          "title": "Private by design",
          "text": "Sign in with email or Google. Your money data stays behind row-level security — only you can see it."
        }
      }
    },
    "deepDive": {
      "eyebrow": "Under the hood",
      "title": "Every tool you need to stay on pace",
      "items": {
        "overview": {
          "title": "Live overview",
          "text": "KPIs for saved goals, monthly income, outflow and net savings — plus cash-flow charts and budget watch at a glance."
        },
        "transactions": {
          "title": "Full transaction history",
          "text": "Search merchants, filter by category or date range, edit or delete in bulk, and keep a clean ledger all cycle."
        },
        "budgetsGoals": {
          "title": "Budgets & goals together",
          "text": "Category caps and savings funds live side by side so you know what is left to spend and what is left to save."
        },
        "receipts": {
          "title": "Receipt to expense",
          "text": "Upload a photo, review the AI draft, and confirm — no retyping amounts from crumpled receipts."
        }
      }
    },
    "how": {
      "eyebrow": "Up and running in minutes",
